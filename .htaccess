# Block direct access to application internals
<FilesMatch "^cron\.php$">
    Deny from all
</FilesMatch>

# Never serve a SQLite database, even if one lands at the web root
<FilesMatch "\.db(-wal|-shm)?$">
    Deny from all
</FilesMatch>

RewriteEngine On

RewriteRule ^src/ - [F,L]
RewriteRule ^templates/ - [F,L]
RewriteRule ^db/ - [F,L]
RewriteRule ^config\.php$ - [F,L]
